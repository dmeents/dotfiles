[user]
	name = David Meents
	email = dmeents@pm.me
	signingkey = E7B7F5595C08E8A6

[commit]
	gpgsign = true

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[diff]
	colorMoved = default

[merge]
	conflictstyle = diff3

[rebase]
	autoStash = true

[credential "https://github.com"]
{{- if eq .chezmoi.os "darwin" }}
	helper = /opt/homebrew/bin/gh auth git-credential
{{- else }}
	helper = /usr/bin/gh auth git-credential
{{- end }}

[credential "https://gist.github.com"]
{{- if eq .chezmoi.os "darwin" }}
	helper = /opt/homebrew/bin/gh auth git-credential
{{- else }}
	helper = /usr/bin/gh auth git-credential
{{- end }}
