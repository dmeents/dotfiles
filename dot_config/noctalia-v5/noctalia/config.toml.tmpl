# Noctalia v5 (beta) — hand-written config, ported from v4 settings.json.
# Isolated config home: ~/.config/noctalia-v5/noctalia/ (see environment.d/noctalia-v5.conf).
# GUI tweaks land in $NOCTALIA_STATE_HOME/noctalia/settings.toml and override this.
# Managed by chezmoi.

[theme]
mode = "dark"
# Custom palette read directly from palettes/Oxide.json in the config home — no
# runtime fetch/registration, so it's present the moment chezmoi applies. (Was
# briefly source="community"; that depends on Noctalia fetching the palette on
# first run, which isn't guaranteed on a fresh machine.)
source = "custom"
custom_palette = "Oxide"

[shell]
avatar_path = "{{ .chezmoi.homeDir }}/Pictures/Profile Pictures/profile-pic5.jpg"
settings_show_advanced = true
font_family = "DejaVu LGC Sans"
# 12-hour clock (v4 used h:mm AP)
time_format = "{:%I:%M %p}"
date_format = "%A, %B %-d"
# Built-in polkit agent replaces the v4 polkit-agent plugin.
polkit_agent = true
# Built-in clipboard history replaces the v4 cliphist integration.
clipboard_enabled = true
# Everything is pre-configured via these dotfiles; skip the first-run wizard.
setup_wizard_enabled = false

# --- Bar: match v4 layout (top, always visible) ---
[bar.default]
position = "top"
auto_hide = false
start = [ "workspaces", "group:g1" ]
center = [ "clock" ]
end = [ "media", "tray", "group:g2" ]
capsule = true
font_family = "JetBrainsMono Nerd Font"
# Styling tuned in the v5 GUI, folded back from state settings.toml.
contact_shadow = true
padding = 11
scale = 1.2
thickness = 41
widget_spacing = 9
margin_edge = 0
margin_ends = 0

# Capsule groups (GUI tweak): pill-grouped widget clusters referenced as
# "group:<id>" in the start/end lists above. g1 = system monitors, g2 =
# notifications/control-center/battery. NOTE: the array-of-tables must stay
# below all bare [bar.default] keys (TOML requires it).
[[bar.default.capsule_group]]
id = "g1"
members = [ "cpu", "ram", "temp" ]
fill = "surface_variant"
opacity = 1.0
padding = 6.0

[[bar.default.capsule_group]]
id = "g2"
members = [ "notifications", "control-center", "battery" ]
fill = "surface_variant"
opacity = 1.0
padding = 6.0

# Panel/launcher behaviour (GUI tweaks).
[shell.panel]
launcher_placement = "attached"
transparency_mode = "glass"

[shell.launcher]
session_search = true

# Control center width (GUI tweak).
[control_center]
width = 900

# Tray uses a drawer (GUI tweak).
[widget.tray]
drawer = true

# Desktop widget layer off (GUI tweak).
[desktop_widgets]
enabled = false

# Lockscreen layout (GUI tweak) — display-specific: the widget key/output and
# pixel coords target this laptop's eDP-1 panel, so it's gated to the laptop via
# the machine_type prompt. On a desktop the block is omitted and Noctalia's
# default lockscreen (login box auto-placed on the active output) is used.
{{- if eq .machine_type "laptop" }}
[lockscreen_widgets]
enabled = false
schema_version = 2
widget_order = [ "lockscreen-login-box@eDP-1" ]

[lockscreen_widgets.grid]
cell_size = 16
major_interval = 4
visible = true

[lockscreen_widgets.widget."lockscreen-login-box@eDP-1"]
box_height = 70.0
box_width = 400.0
cx = 960.0
cy = 1161.0
output = "eDP-1"
rotation = 0.0
type = "login_box"

[lockscreen_widgets.widget."lockscreen-login-box@eDP-1".settings]
background_color = "surface_variant"
background_opacity = 0.88
background_radius = 12.0
input_opacity = 1.0
input_radius = 6.0
show_caps_lock = true
show_keyboard_layout = true
show_login_button = true
show_password_hint = true
{{- end }}

# --- Weather: enabled, Celsius, IP-based auto-location ---
# auto_locate=true uses IP-based geolocation (folded back from the v5 GUI). The
# fixed coordinates below are kept as a fallback (used only if auto_locate is
# turned back off); they come from the location_* prompts in .chezmoi.toml.tmpl.
[location]
# Location fallback: {{ .location_display_name }}
auto_locate = true
latitude = {{ .location_latitude }}
longitude = {{ .location_longitude }}

[weather]
enabled = true
unit = "metric"

# --- Idle/lock (v4: lock 600s, screen-off 300s, suspend 1800s) ---
# `action` must be set explicitly; a partial table does not inherit the default.
[idle.behavior.lock]
enabled = true
action = "lock"
timeout = 600.0

[idle.behavior.screen-off]
enabled = true
action = "screen_off"
timeout = 300.0

[idle.behavior.lock-and-suspend]
enabled = true
action = "lock_and_suspend"
timeout = 1800.0

# --- Wallpaper (v4: ~/Pictures/Wallpapers, random 300s, automation off) ---
[wallpaper]
enabled = true
directory = "{{ .chezmoi.homeDir }}/Pictures/Wallpapers"

[wallpaper.automation]
enabled = false
interval_seconds = 300
order = "random"

# Selected wallpaper (GUI tweak). The image itself is tracked under
# ~/Pictures/Wallpapers/ so a fresh machine has it.
[wallpaper.default]
path = "{{ .chezmoi.homeDir }}/Pictures/Wallpapers/wallhaven_ymg1o7.jpg"
