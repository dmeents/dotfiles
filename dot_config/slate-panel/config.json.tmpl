{
  "terminal": "warp-terminal",
  "theme": {
    "dark": "min-dark",
    "light": "kanso-pearl"
  },
  "location": {
    "provider": {
      "name": "latitudeAndLongitude",
      "options": {
        "displayName": {{ .location_display_name | quote }},
        "latitude": {{ .location_latitude }},
        "longitude": {{ .location_longitude }}
      }
    }
  },
  "notifications": {
    "timeoutSeconds": 5
  },
  "bar": {
    "side": "top",
    "start": {
      "modules": [
        {
          "hyprWorkspace": {}
        },
        {
          "hardware": {}
        },
        {
          "systemUptime": {}
        }
      ]
    },
    "center": {
      "modules": [
        {
          "clock": {
            "timeFormat": "%I:%M %p",
            "dateFormat": "%a, %B %d",
            "format": "{{ `{{date}}  {{time}}` }}"
          }
        },
        {
          "weather": {}
        }
      ]
    },
    "end": {
      "modules": [
        { "mediaPlayer": {} },
        { "audio": {} },
        {
          "network": {
            "popover": {
              "vpnToggleButton": {
                "disable": {
                  "label": "Disconnect VPN",
                  "action": { "runCommand": "tailscale down" }
                },
                "enable": {
                  "label": "Connect VPN",
                  "action": { "runCommand": "tailscale up --accept-routes" }
                }
              }
            }
          }
        },
        { "notifications": {} },
        { "packageUpdates": {} },
        { "power": {} }
      ]
    }
  }
}
