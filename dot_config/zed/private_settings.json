{
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "bypassPermissions",
        "effort": "default",
        "model": "opus[1m]"
      },
      "type": "registry"
    }
  },
  "outline_panel": {
    "button": false
  },
  "collaboration_panel": {
    "button": false
  },
  "git_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "left"
  },
  "show_edit_predictions": true,
  "base_keymap": "JetBrains",
  "ui_font_size": 16,
  "buffer_font_size": 15.0,
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "theme": {
    "mode": "system",
    "light": "Noctalia Dark",
    "dark": "Noctalia Dark"
  },
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "ui_font_features": {
    "liga": true
  },
  "edit_predictions": {
    "open_ai_compatible_api": {
      "api_url": ""
    },
    "allow_data_collection": "no",
    "mode": "eager",
    "disabled_globs": [".env"]
  },
  "soft_wrap": "editor_width",
  "tab_size": 2,
  "git": {
    "inline_blame": {
      "enabled": true
    },
    "git_gutter": "tracked_files"
  },
  "terminal": {
    "button": false,
    "env": {
      "EDITOR": "zed --wait"
    },
    "shell": "system",
    "working_directory": "current_project_directory"
  },
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    },
    "eslint": {
      "settings": {
        "codeActionOnSave": {
          "enable": true,
          "mode": "all"
        }
      }
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "preferences": {
            "importModuleSpecifier": "project-relative"
          }
        }
      }
    }
  },
  "agent": {
    "profiles": {
      
    },
    "dock": "right",
    "favorite_models": [
      {
        "provider": "anthropic",
        "model": "claude-sonnet-4-5-latest",
        "enable_thinking": false
      },
      {
        "provider": "anthropic",
        "model": "claude-opus-4-5-latest",
        "enable_thinking": false
      },
      {
        "provider": "anthropic",
        "model": "claude-opus-4-8",
        "enable_thinking": true,
        "effort": "high"
      }
    ],
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "anthropic",
      "model": "claude-opus-4-8"
    }
  },
  "context_servers": {
    
  },
  "languages": {
    "JSON": {
      "formatter": "language_server",
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "Markdown": {
      "formatter": "language_server"
    },
    "Plain Text": {
      "show_edit_predictions": false
    },
    "JavaScript": {
      "formatter": "language_server",
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
        "source.fixAll.eslint": true
      }
    },
    "TypeScript": {
      "formatter": "language_server",
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
        "source.fixAll.eslint": true
      }
    },
    "TSX": {
      "formatter": "language_server",
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
        "source.fixAll.eslint": true
      }
    },
    "Rust": {
      "format_on_save": "on",
      "tab_size": 4,
      "formatter": "language_server"
    },
    "Python": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "black",
          "arguments": ["-"]
        }
      },
      "tab_size": 4
    },
    "Go": {
      "format_on_save": "on",
      "tab_size": 4,
      "hard_tabs": true,
      "formatter": "language_server"
    },
    "TOML": {
      "tab_size": 2
    },
    "YAML": {
      "tab_size": 2
    }
  }
}
