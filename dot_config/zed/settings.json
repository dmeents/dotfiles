// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "show_edit_predictions": true,
  "base_keymap": "JetBrains",
  "ui_font_size": 16,
  "buffer_font_size": 15.0,
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Min Dark (Solid)"
  },
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "ui_font_features": {
    "liga": true
  },
  "edit_predictions": {
    "mode": "eager",
    "disabled_globs": [".env"]
  },
  "inlay_hints": {
    "enabled": true
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": null
    }
  },
  "soft_wrap": "none",
  "tab_size": 2,
  "file_watcher": {
    "enabled": true
  },
  "git": {
    "enabled": true,
    "inline_blame": {
      "enabled": true
    },
    "git_gutter": "tracked_files"
  },
  "terminal": {
    "env": {
      "EDITOR": "zed --wait"
    },
    "shell": "system",
    "working_directory": "current_project_directory"
  },
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "preferences": {
            "importModuleSpecifier": "project-relative"
          }
        }
      }
    }
  },
  "languages": {
    "JSON": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "Markdown": {
      "formatter": "prettier"
    },
    "Plain Text": {
      "show_edit_predictions": false
    },
    "JavaScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "TypeScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "TSX": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "Rust": {
      "format_on_save": "on",
      "tab_size": 4,
      "formatter": "language_server"
    },
    "Python": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "black",
          "arguments": ["-"]
        }
      },
      "tab_size": 4
    },
    "Go": {
      "format_on_save": "on",
      "tab_size": 4,
      "hard_tabs": true,
      "formatter": "language_server"
    },
    "TOML": {
      "tab_size": 2
    },
    "YAML": {
      "tab_size": 2
    }
  }
}
