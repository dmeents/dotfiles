general {
  lock_cmd = pidof hyprlock || hyprlock
  before_sleep_cmd = loginctl lock-session
  after_sleep_cmd = hyprctl dispatch dpms on
}

# Grace period warning before dimming
listener {
{{- if eq .machine_type "laptop" }}
  timeout = 150
{{- else }}
  timeout = 270
{{- end }}
  on-timeout = notify-send "Idle Warning" "Screen will dim in 30 seconds" -u low -t 5000
}

# Dim screen
listener {
{{- if eq .machine_type "laptop" }}
  timeout = 180
{{- else }}
  timeout = 300
{{- end }}
  on-timeout = brightnessctl -s set 10
  on-resume = brightnessctl -r
}

# Lock screen
listener {
{{- if eq .machine_type "laptop" }}
  timeout = 300
{{- else }}
  timeout = 600
{{- end }}
  on-timeout = loginctl lock-session
}

# DPMS off
listener {
{{- if eq .machine_type "laptop" }}
  timeout = 600
{{- else }}
  timeout = 900
{{- end }}
  on-timeout = hyprctl dispatch dpms off
  on-resume = hyprctl dispatch dpms on
}
{{- if eq .machine_type "laptop" }}

# Suspend on laptop after extended idle
listener {
  timeout = 1200
  on-timeout = systemctl suspend
}
{{- end }}
