local mainMod = "SUPER"
-- Noctalia IPC. Inline env keeps `noctalia msg` pointed at the isolated
-- config/state home regardless of session env propagation.
local noctMsg = "env NOCTALIA_CONFIG_HOME={{ .chezmoi.homeDir }}/.config/noctalia-v5 NOCTALIA_STATE_HOME={{ .chezmoi.homeDir }}/.local/state/noctalia-v5 noctalia msg "
local launchPrefix = "uwsm app -- " -- if you are not using UWSM, make this empty (e.g. "")

---------------------------
---- WINDOW MANAGEMENT ----
---------------------------

hl.bind(mainMod .. " + Escape",      hl.dsp.exec_cmd("hyprctl kill"))
hl.bind(mainMod .. " + Q",           hl.dsp.window.close())
hl.bind(mainMod .. " + ALT + Space", hl.dsp.window.float({ action = "toggle" }))
hl.bind(mainMod .. " + D",           hl.dsp.window.fullscreen({ mode = 1 }))
hl.bind(mainMod .. " + F",           hl.dsp.window.fullscreen())
hl.bind(mainMod .. " + J",           hl.dsp.layout("togglesplit"))
hl.bind(mainMod .. " + L",           hl.dsp.exec_cmd(noctMsg .. "session lock"))
hl.bind(mainMod .. " + ALT + C",     hl.dsp.exec_cmd(noctMsg .. "panel-toggle session"))

-- Change focus
hl.bind(mainMod .. " + Left",  hl.dsp.focus({ direction = "left" }))
hl.bind(mainMod .. " + Right", hl.dsp.focus({ direction = "right" }))
hl.bind(mainMod .. " + Up",    hl.dsp.focus({ direction = "up" }))
hl.bind(mainMod .. " + Down",  hl.dsp.focus({ direction = "down" }))
hl.bind("ALT + Tab",           hl.dsp.window.cycle_next())

-- Move active window around current workspace
hl.bind(mainMod .. " + SHIFT + Right", hl.dsp.window.move({ direction = "r" }))
hl.bind(mainMod .. " + SHIFT + Left",  hl.dsp.window.move({ direction = "l" }))
hl.bind(mainMod .. " + SHIFT + Up",    hl.dsp.window.move({ direction = "u" }))
hl.bind(mainMod .. " + SHIFT + Down",  hl.dsp.window.move({ direction = "d" }))
hl.bind(mainMod .. " + CONTROL + SHIFT + Right", hl.dsp.window.move({ workspace = "r+1" }))
hl.bind(mainMod .. " + CONTROL + SHIFT + Left",  hl.dsp.window.move({ workspace = "r-1" }))

-- Move & Resize with mouse
hl.bind(mainMod .. " + mouse:272", hl.dsp.window.drag())
hl.bind(mainMod .. " + mouse:273", hl.dsp.window.resize())

-- Resize submap: SUPER + R enters resize mode; arrow keys / hjkl resize the
-- active window (15px steps); Escape exits. (Ported from the v4 config.)
hl.define_submap("resize", function()
  local steps = {
    { "right", 15,   0   },
    { "left",  -15,  0   },
    { "up",    0,    -15 },
    { "down",  0,    15  },
    { "l",     15,   0   },
    { "h",     -15,  0   },
    { "k",     0,    -15 },
    { "j",     0,    15  },
  }
  for _, s in ipairs(steps) do
    hl.bind(s[1],
      hl.dsp.window.resize({ x = s[2], y = s[3], relative = true }),
      { repeating = true, description = "Resize active window (" .. s[1] .. ")" })
  end

  hl.bind("escape", hl.dsp.submap("reset"),
    { description = "Exit resize mode" })
end)

hl.bind(mainMod .. " + R", hl.dsp.submap("resize"),
  { description = "Enter window-resize mode" })

------------------
---- LAUNCHER ----
------------------

hl.bind(mainMod .. " + Return",     hl.dsp.exec_cmd(launchPrefix .. TERMINAL))
hl.bind(mainMod .. " + E",          hl.dsp.exec_cmd(launchPrefix .. FILE_MANAGER))
hl.bind(mainMod .. " + T",          hl.dsp.exec_cmd(launchPrefix .. EDITOR))
hl.bind(mainMod .. " + C",          hl.dsp.exec_cmd(launchPrefix .. CALCULATOR))
hl.bind(mainMod .. " + W",          hl.dsp.exec_cmd(launchPrefix .. BROWSER))
hl.bind("CONTROL + SHIFT + Escape", hl.dsp.exec_cmd(launchPrefix .. TERMINAL .. " -e btop"))
hl.bind(mainMod .. " + Z",          hl.dsp.exec_cmd(noctMsg .. "settings-toggle"))
hl.bind(mainMod .. " + X",          hl.dsp.exec_cmd(noctMsg .. "panel-toggle control-center"))
hl.bind(mainMod .. " + Space",      hl.dsp.exec_cmd(noctMsg .. "panel-toggle launcher"))
hl.bind(mainMod .. " + period",     hl.dsp.exec_cmd(noctMsg .. "panel-toggle launcher /emo"))

---------------------------
---- HARDWARE CONTROLS ----
---------------------------

-- Audio (Prior = PageUp, Next = PageDown)
hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd(noctMsg .. "volume-up"),   { locked = true, repeating = true })
hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd(noctMsg .. "volume-down"), { locked = true, repeating = true })
hl.bind(mainMod .. " + Prior",  hl.dsp.exec_cmd(noctMsg .. "volume-up"),   { locked = true, repeating = true })
hl.bind(mainMod .. " + Next",   hl.dsp.exec_cmd(noctMsg .. "volume-down"), { locked = true, repeating = true })
hl.bind("XF86AudioMute",        hl.dsp.exec_cmd(noctMsg .. "volume-mute"), { locked = true, repeating = true })
hl.bind("XF86AudioMicMute",     hl.dsp.exec_cmd(noctMsg .. "mic-mute"),    { locked = true, repeating = true })

-- Media
hl.bind("XF86AudioPlay",  hl.dsp.exec_cmd(noctMsg .. "media toggle"), { locked = true })
hl.bind("XF86AudioPause", hl.dsp.exec_cmd(noctMsg .. "media toggle"), { locked = true })
hl.bind("XF86AudioNext",  hl.dsp.exec_cmd(noctMsg .. "media next"),      { locked = true })
hl.bind("XF86AudioPrev",  hl.dsp.exec_cmd(noctMsg .. "media previous"),  { locked = true })

-- Brightness
hl.bind("XF86MonBrightnessUp",   hl.dsp.exec_cmd(noctMsg .. "brightness-up"),   { repeating = true })
hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd(noctMsg .. "brightness-down"), { repeating = true })

-------------------
---- UTILITIES ----
-------------------

-- Screen Capture (v5 built-in screenshots replace the v4 screen-toolkit plugin)
hl.bind("Print",               hl.dsp.exec_cmd(noctMsg .. "screenshot-fullscreen"))
hl.bind(mainMod .. " + Print", hl.dsp.exec_cmd(noctMsg .. "screenshot-region"))
-- v4 screen-toolkit parity gaps in v5 (no built-in / no official plugin yet):
--   * color picker (was Super+P): unbound. Fallback: bind an external tool (e.g. hyprpicker).
--   * annotation / OCR: no v5 equivalent.
--   * screen recording (was Super+R, now the resize submap): enable the official
--     "screen_recorder" plugin, then bind an unused key via
--     `noctalia msg plugin <author/plugin:entry> <target> <event>` per its docs.
-- hl.bind(mainMod .. " + P",     hl.dsp.exec_cmd("hyprpicker -a"))
-- hl.bind(mainMod .. " + SHIFT + R", hl.dsp.exec_cmd(noctMsg .. "plugin noctalia/screen_recorder:... ..."))

-- Theming and Wallpaper
hl.bind(mainMod .. " + SHIFT + W", hl.dsp.exec_cmd(noctMsg .. "panel-toggle wallpaper"))

-- Clipboard
hl.bind(mainMod .. " + V", hl.dsp.exec_cmd(noctMsg .. "panel-toggle clipboard"))

--------------------
---- WORKSPACES ----
--------------------

for i = 1, 10 do
    local key = i % 10
    hl.bind(mainMod .. " + " .. key,         hl.dsp.focus({ workspace = i }))
    hl.bind(mainMod .. " + SHIFT + " .. key, hl.dsp.window.move({ workspace = i, follow = true }))
    hl.bind(mainMod .. " + ALT + " .. key,   hl.dsp.window.move({ workspace = i, follow = false }))
end

hl.bind(mainMod .. " + CONTROL + Right",       hl.dsp.focus({ workspace = "r+1" }))
hl.bind(mainMod .. " + CONTROL + Left",        hl.dsp.focus({ workspace = "r-1" }))
hl.bind(mainMod .. " + CONTROL + Down",        hl.dsp.focus({ workspace = "empty" }))
hl.bind(mainMod .. " + CONTROL + ALT + Right", hl.dsp.window.move({ workspace = "r+1" }))
hl.bind(mainMod .. " + CONTROL + ALT + Left",  hl.dsp.window.move({ workspace = "r-1" }))

-- Scroll through existing workspaces
hl.bind(mainMod .. " + mouse_down", hl.dsp.focus({ workspace = "e+1" }))
hl.bind(mainMod .. " + mouse_up",   hl.dsp.focus({ workspace = "e-1" }))

-- Special workspace (scratchpad)
hl.bind(mainMod .. " + SHIFT + S", hl.dsp.window.move({ workspace = "special" }))
hl.bind(mainMod .. " + S",         hl.dsp.workspace.toggle_special())

-----------------------
---- NOTIFICATIONS ----
-----------------------

-- v5 has no standalone notifications panel; notification history lives in the
-- control center. Opens control center at its notification section.
-- NOTE: confirm the section context name ("notification") matches your v5 build.
hl.bind(mainMod .. " + A", hl.dsp.exec_cmd(noctMsg .. "panel-toggle control-center notification"))
