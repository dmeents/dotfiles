# Ghostty config — managed by chezmoi. Reference: https://ghostty.org/docs/config
# Ghostty reads THIS file (~/.config/ghostty/config). A file named
# "config.ghostty" is ignored — that stray empty one was a misnamed leftover.

# --- Appearance -------------------------------------------------------------
theme = noctalia

# JetBrainsMono Nerd Font: has programming ligatures AND the glyphs starship
# needs. Ghostty renders ligatures by default for fonts that provide them,
# so no extra setting is required to get them.
font-family = JetBrainsMono Nerd Font
font-size = 12

# Subtle translucency + blur for a modern look (Hyprland compositor handles it).
background-opacity = 0.95
background-blur = true

# Breathing room around the text grid.
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# --- Session ----------------------------------------------------------------
# Every Ghostty window attaches to the persistent Zellij session "main", so
# tabs, splits and scrollback survive closing the window and rebooting. Ghostty
# can't do this itself: `window-save-state` is macOS-only and has no effect on
# the GTK runtime. Applies however Ghostty is launched (app launcher, D-Bus,
# Super+Return). `ghostty -e <cmd>` overrides it for that window, which is how
# Super+Shift+Return gets a plain shell. A second window is a second client on
# the same session, not a separate shell — use Zellij tabs (Ctrl+t n) instead.
command = zellij attach --create main

# --- Tabs & window ----------------------------------------------------------
# Ghostty's own tabs/splits (Ctrl+Shift+T / O / E) would also run the command
# above, i.e. open another view of the same session. Use Zellij's instead.
gtk-tabs-location = top
window-theme = ghostty

# --- Behavior ---------------------------------------------------------------
confirm-close-surface = false
copy-on-select = clipboard
