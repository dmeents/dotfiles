#!/bin/bash
# Install CachyOS packages for the noctalia profile via shelly.
# shelly is the CachyOS Noctalia spin's unified package manager (repo + AUR +
# flatpak); it is the ONLY installer used on this branch — never pacman/paru.
# This script re-runs automatically whenever the manifest content changes:
# manifest sha256: {{ include "dot_local/share/dotfiles/packages-linux.txt" | sha256sum }}
# ...AND whenever any manifest package is missing from the system, so a failed
# install (e.g. a transient AUR build failure) self-heals on the next apply
# instead of staying missing until the manifest text changes. The line below is
# the space-separated set of currently-absent manifest packages; when it changes
# (a package appears missing, or a retry succeeds), the script re-runs.
# missing packages: {{ output "bash" "-c" (printf `for p in $(grep -vE '^[[:space:]]*(#|$)' '%s/dot_local/share/dotfiles/packages-linux.txt'); do command -v pacman >/dev/null 2>&1 && { pacman -Qq -- "$p" >/dev/null 2>&1 || printf '%%s ' "$p"; }; done; true` .chezmoi.sourceDir) | trim }}
# `shelly install` handles ONLY repo packages/files/URLs — AUR names must go
# through `shelly aur install`. We classify each manifest entry at runtime and
# route accordingly, so one AUR name can't abort the whole ALPM transaction.
# No `set -e`: we attempt every package and report failures at the end.
set -uo pipefail

MANIFEST="$HOME/.local/share/dotfiles/packages-linux.txt"
if [ ! -r "$MANIFEST" ]; then
    echo "==> package manifest not found at $MANIFEST; skipping" >&2
    exit 0
fi

if ! command -v shelly >/dev/null 2>&1; then
    echo "==> shelly not found on PATH; cannot install packages" >&2
    exit 1
fi

echo "==> Enabling AUR support in shelly"
shelly config set AurEnabled true

echo "==> Syncing system (shelly upgrade)"
shelly upgrade -n || echo "warning: 'shelly upgrade' returned non-zero; continuing"

# Read manifest, ignoring comments and blank lines.
mapfile -t want < <(grep -vE '^[[:space:]]*(#|$)' "$MANIFEST")
if ((${#want[@]} == 0)); then
    echo "==> manifest is empty; nothing to install"
    exit 0
fi

# Classify each name as repo (in a sync database) vs AUR-only.
# NOTE: we deliberately do NOT use `shelly query -j` here. It reports every
# *installed* package as Repository="local", so an installed AUR package looks
# identical to a repo package and gets routed into the `shelly install` batch —
# which then aborts with "target not found in any sync database". Instead we ask
# the sync databases directly with a read-only `pacman -Si` (exit 0 == the name
# resolves in a sync repo). This is a query only; `shelly` is still the sole
# INSTALLER on this branch. The dbs were just refreshed by `shelly upgrade` above.
repo=(); aur=()
for p in "${want[@]}"; do
    if pacman -Si -- "$p" >/dev/null 2>&1; then
        repo+=("$p")
    else
        aur+=("$p")
    fi
done

failed=()

# Repo packages: one ALPM transaction, falling back to per-package on failure.
if ((${#repo[@]})); then
    echo "==> Installing ${#repo[@]} repo package(s) via 'shelly install'..."
    if ! shelly install -n "${repo[@]}"; then
        echo "==> Repo batch failed; retrying per-package to isolate offenders..." >&2
        for p in "${repo[@]}"; do
            shelly install -n "$p" && continue
            # A package already installed from the AUR also matches `shelly query`
            # and lands here on a re-run — try the AUR path before giving up.
            shelly aur install -n "$p" || failed+=("$p")
        done
    fi
fi

# Rust-based AUR packages (e.g. millennium) build via Corrosion/CMake, which
# needs a *default* rustup toolchain. The `rustup` package installs without
# selecting one, so its first build fails with "Could not find toolchain ''"
# AND caches that empty value, poisoning every retry. Set the default up front.
if ((${#aur[@]})) && command -v rustup >/dev/null 2>&1; then
    rustup default stable >/dev/null 2>&1 || true
fi

# AUR packages: must use `shelly aur install`; per-package fallback on failure.
if ((${#aur[@]})); then
    echo "==> Installing ${#aur[@]} AUR package(s) via 'shelly aur install'..."
    if ! shelly aur install -n "${aur[@]}"; then
        echo "==> AUR batch failed; retrying per-package to isolate offenders..." >&2
        for p in "${aur[@]}"; do
            shelly aur install -n "$p" || failed+=("$p")
        done
    fi
fi

if ((${#failed[@]})); then
    echo "==> ${#failed[@]} package(s) could not be installed: ${failed[*]}" >&2
    echo "==> Fix their names in the manifest or investigate, then re-apply." >&2
    exit 1
fi
echo "==> Package sync complete."
